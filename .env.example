# ============================================
# Telegram Self-Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Application
# ============================================
APP_NAME=Telegram Self-Bot
APP_VERSION=1.0.0
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
APP_LOG_LEVEL=INFO
APP_LOG_FILE=logs/app.log

# ============================================
# Database
# ============================================
DATABASE_URL=sqlite:///./storage/database.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/telegram_bot
# For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/telegram_bot

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ============================================
# Telegram API
# ============================================
# Get these from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_SESSION_STRING=
TELEGRAM_PHONE=+1234567890

# ============================================
# Security
# ============================================
JWT_SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-this-to-a-random-32-byte-key
CSRF_SECRET_KEY=change-this-to-a-random-secret-key
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# AI Providers (Optional)
# ============================================
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
LOCAL_LLM_URL=

# ============================================
# Media & Storage
# ============================================
MEDIA_STORAGE_PATH=storage/media
BACKUP_STORAGE_PATH=storage/backups
MAX_UPLOAD_SIZE=52428800
STORAGE_MAX_SIZE=10737418240

# ============================================
# FFmpeg
# ============================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=base

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60
TELEGRAM_FLOOD_WAIT_ENABLED=true

# ============================================
# Task Queue
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# Scheduler
# ============================================
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# ============================================
# Backup
# ============================================
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_COMPRESSION_LEVEL=6

# ============================================
# WebSocket
# ============================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/ws

# ============================================
# Health Check
# ============================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
